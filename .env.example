PORT=3000
JWT_SECRET=replace-with-at-least-32-random-chars
GUEST_PIN=replace-with-family-pin
NODE_ENV=production

# Owner account — used on first boot only to seed the owner user.
# After first boot these values are ignored (the account already exists in the DB).
# OWNER_NAME defaults to "Registry Owner" if not set.
OWNER_EMAIL=your-email@example.com
OWNER_NAME=Your Name
OWNER_SEED_PASSWORD=replace-with-a-strong-seed-password
